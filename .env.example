# Strapi REST API token (Settings → API Tokens, read-only)
# Read-only token for public CMS content.
STRAPI_READ_TOKEN=tobemodified

# Dedicated token limited to Upload:create and Gift-order:create.
STRAPI_GIFT_WRITE_TOKEN=tobemodified
# Enable only after private barcode storage and delivery settings are verified.
GIFT_ORDERS_ENABLED=false

# Strapi API base URL
# dev (docker-compose.dev.yml): http://localhost:1443/api
# prod (docker-compose.yml):    http://localhost:1441/api
# Публичный адрес CMS: https://cms.lightyar.ru (API: /api, админка: /admin).
# На одном VPS сервер Next.js обращается к CMS через внутренний порт 1441.
STRAPI_API_URL=http://localhost:1443/api
# Адрес сайта целиком, с протоколом и без слеша на конце.
# Уходит в canonical, в разметку для поисковика и в ссылки для соцсетей,
# поэтому на каждой площадке свой:
#   разработка: http://localhost:3000
#   боевая:     https://lightyar.ru
# Без ключа берётся боевой адрес: относительные ссылки в разметке хуже
# неверного домена.
NEXT_PUBLIC_SITE_URL=https://lightyar.ru
